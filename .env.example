SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVkeWFmdHJmZmx4dHRscm9pbHNxIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzQ3ODY1MiwiZXhwIjoyMDkzMDU0NjUyfQ.B96-5kLRpypdJWPPWNj3DGcgSx3B6x7UUo3ZB0N1EGk

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096

# =============================================================================
# N8N WEBHOOK CONFIGURATION
# =============================================================================
# Your n8n instance webhook URL for triggering automation workflows
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/seo-automation
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret-key
# Optional: n8n API for status checking
N8N_API_URL=https://your-n8n-instance.com/api/v1
N8N_API_KEY=your-n8n-api-key

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="AI SEO Platform"
NODE_ENV=development

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
# Supabase Storage bucket names (create these in Supabase dashboard)
SUPABASE_STORAGE_BUCKET_LOGOS=client-logos
SUPABASE_STORAGE_BUCKET_UPLOADS=report-uploads
SUPABASE_STORAGE_BUCKET_REPORTS=generated-reports

# =============================================================================
# SECURITY
# =============================================================================
# Secret for signing internal API calls (generate with: openssl rand -hex 32)
INTERNAL_API_SECRET=your-internal-api-secret-32-chars

# =============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS (Resend)
# =============================================================================
# RESEND_API_KEY=re_your-resend-api-key
# EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# OPTIONAL: RATE LIMITING (Upstash Redis)
# =============================================================================
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
